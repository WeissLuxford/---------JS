rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == 'ВСТАВЬ_СВОЙ_UID';
    }

    function notBanned() {
      return signedIn() && !exists(/databases/$(database)/documents/bans/$(request.auth.uid));
    }

    function myEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        ? request.auth.token.email.lower()
        : '';
    }

    function charDoc(id) {
      return get(/databases/$(database)/documents/characters/$(id));
    }

    function ownerOf(data) {
      return data.get('ownerUid', '');
    }

    function isOwner(data) {
      return signedIn() && ownerOf(data) != '' && ownerOf(data) == request.auth.uid;
    }

    function isEditor(id) {
      return myEmail() != ''
        && exists(/databases/$(database)/documents/characters/$(id)/acl/main)
        && myEmail() in get(/databases/$(database)/documents/characters/$(id)/acl/main).data.get('emails', []);
    }

    function canEdit(id, data) {
      return isAdmin() || (notBanned() && (isOwner(data) || isEditor(id)));
    }

    function validCharacter(data) {
      return data.keys().size() < 60
        && data.get('name', '') is string
        && data.get('name', '').size() <= 120
        && data.get('portrait', '') is string
        && data.get('portrait', '').size() <= 400000;
    }

    match /characters/{id} {
      allow get: if true;
      allow list: if isAdmin() || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
      allow create: if notBanned()
        && request.resource.data.get('ownerUid', '') == request.auth.uid
        && validCharacter(request.resource.data);
      allow update: if canEdit(id, resource.data)
        && validCharacter(request.resource.data)
        && (isAdmin() || request.resource.data.get('ownerUid', '') == ownerOf(resource.data));
      allow delete: if isAdmin() || (notBanned() && isOwner(resource.data));

      match /history/{h} {
        allow read: if canEdit(id, charDoc(id).data);
        allow create: if canEdit(id, charDoc(id).data)
          && request.resource.data.keys().hasOnly(['at', 'reason', 'by', 'data']);
        allow update: if false;
        allow delete: if isAdmin() || (notBanned() && isOwner(charDoc(id).data));
      }

      match /acl/{doc} {
        allow read: if isAdmin()
          || isOwner(charDoc(id).data)
          || (myEmail() != '' && myEmail() in resource.data.get('emails', []));
        allow create, update: if (isAdmin() || (notBanned() && isOwner(charDoc(id).data)))
          && doc == 'main'
          && request.resource.data.get('emails', []) is list
          && request.resource.data.get('emails', []).size() <= 20;
        allow delete: if isAdmin() || (notBanned() && isOwner(charDoc(id).data));
      }
    }

    match /invites/{email}/chars/{id} {
      allow read: if isAdmin() || (myEmail() != '' && myEmail() == email);
      allow create, update, delete: if isAdmin() || (notBanned() && isOwner(charDoc(id).data));
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'photo', 'createdAt', 'lastSeen']);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /bans/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /admin/{doc} {
      allow read: if isAdmin();
    }

    match /meta/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
