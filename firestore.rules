rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isGoogle() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function isAdmin() { return isGoogle() && request.auth.uid == 'ВСТАВЬ_СВОЙ_UID'; }
    function notBanned() { return isGoogle() && !exists(/databases/$(database)/documents/bans/$(request.auth.uid)); }
    function myEmail() {
      return isGoogle() && request.auth.token.email is string && request.auth.token.email_verified == true
        ? request.auth.token.email.lower() : '';
    }
    function nowMs() { return request.time.toMillis(); }
    function notFuture(v) { return v is number && v <= nowMs() + 3600000; }
    function charDoc(id) { return get(/databases/$(database)/documents/characters/$(id)); }
    function ownerOf(data) { return data.get('ownerUid', ''); }
    function isOwner(data) { return signedIn() && ownerOf(data) != '' && ownerOf(data) == request.auth.uid; }
    function aclPath(id) { return /databases/$(database)/documents/characters/$(id)/acl/main; }
    function isEditor(id) {
      return myEmail() != '' && exists(aclPath(id)) && myEmail() in get(aclPath(id)).data.get('emails', []);
    }
    function canEdit(id, data) { return isAdmin() || (notBanned() && (isOwner(data) || isEditor(id))); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function optStr(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }
    function optList(d, k, n) { return !(k in d) || (d[k] is list && d[k].size() <= n); }
    function validCharacter(d) {
      return d.keys().size() < 60
        && d.get('name', '') is string && d.get('name', '').size() <= 120
        && d.get('portrait', '') is string && d.get('portrait', '').size() <= 400000
        && d.get('visibility', 'link') in ['link', 'private']
        && optStr(d, 'ownerName', 60)
        && optList(d, 'attacks', 60) && optList(d, 'spells', 300)
        && optList(d, 'features', 300) && optList(d, 'items', 500)
        && notFuture(d.get('updatedAt', 0))
        && d.get('updatedBy', {}) is map && d.get('updatedBy', {}).size() <= 8
        && d.get('updatedBy', {}).get('uid', '') == request.auth.uid;
    }

    match /characters/{id} {
      allow get: if resource == null
        || resource.data.get('visibility', 'link') == 'link'
        || isOwner(resource.data) || isAdmin() || isEditor(id);
      allow list: if isAdmin() || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
      allow create: if notBanned()
        && !exists(/databases/$(database)/documents/deleted/$(id))
        && request.resource.data.get('ownerUid', '') == request.auth.uid
        && notFuture(request.resource.data.get('createdAt', 0))
        && validCharacter(request.resource.data);
      allow update: if canEdit(id, resource.data)
        && validCharacter(request.resource.data)
        && (isAdmin() || !changed().hasAny(['ownerUid', 'createdAt']))
        && (ownerOf(resource.data) == '' || ownerOf(request.resource.data) != '')
        && (isAdmin() || isOwner(resource.data) || !changed().hasAny(['ownerName', 'visibility']));
      allow delete: if isAdmin() || isOwner(resource.data);

      match /history/{h} {
        allow read: if isAdmin() || isOwner(charDoc(id).data) || isEditor(id);
        allow create: if canEdit(id, charDoc(id).data)
          && request.resource.data.keys().hasOnly(['at', 'reason', 'by', 'data'])
          && notFuture(request.resource.data.at)
          && request.resource.data.reason is string && request.resource.data.reason.size() <= 80
          && request.resource.data.by is map && request.resource.data.by.size() <= 8
          && request.resource.data.by.get('uid', '') == request.auth.uid
          && request.resource.data.data is map && request.resource.data.data.size() < 60
          && !('portrait' in request.resource.data.data);
        allow update: if false;
        allow delete: if isAdmin() || isOwner(charDoc(id).data);
      }

      match /board/{doc} {
        allow get: if doc == 'main'
          && (charDoc(id).data.get('visibility', 'link') == 'link'
            || isOwner(charDoc(id).data) || isAdmin() || isEditor(id));
        allow create, update: if doc == 'main'
          && canEdit(id, charDoc(id).data)
          && request.resource.data.keys().hasOnly(['image', 'updatedAt'])
          && request.resource.data.image is string
          && request.resource.data.image.size() <= 950000
          && notFuture(request.resource.data.updatedAt);
        allow delete: if canEdit(id, charDoc(id).data);
      }

      match /acl/{doc} {
        allow read: if isAdmin() || isOwner(charDoc(id).data);
        allow create, update: if (isAdmin() || (notBanned() && isOwner(charDoc(id).data)))
          && doc == 'main'
          && request.resource.data.keys().hasOnly(['emails', 'updatedAt'])
          && request.resource.data.emails is list
          && request.resource.data.emails.size() <= 20;
        allow delete: if isAdmin() || isOwner(charDoc(id).data);
      }
    }

    match /invites/{email}/chars/{id} {
      allow read: if isAdmin() || (myEmail() != '' && myEmail() == email);
      allow create, update: if (isAdmin() || (notBanned() && isOwner(charDoc(id).data)))
        && email in getAfter(/databases/$(database)/documents/characters/$(id)/acl/main).data.get('emails', [])
        && request.resource.data.keys().hasOnly(['name', 'ownerName', 'ownerUid', 'at'])
        && request.resource.data.get('ownerUid', '') == ownerOf(charDoc(id).data)
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 120
        && request.resource.data.get('ownerName', '') is string && request.resource.data.get('ownerName', '').size() <= 60;
      allow delete: if isAdmin() || (myEmail() != '' && myEmail() == email) || isOwner(charDoc(id).data);
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isGoogle() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'photo', 'createdAt', 'lastSeen'])
        && request.resource.data.get('email', '') == request.auth.token.email
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 80
        && request.resource.data.get('photo', '') is string && request.resource.data.get('photo', '').size() <= 1000
        && request.resource.data.get('photo', '').matches('^(https://[a-z0-9.-]+[.]googleusercontent[.]com/.*)?$');
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /bans/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /admin/{doc} { allow read: if isAdmin(); }

    match /deleted/{id} {
      allow read: if true;
      allow create: if isAdmin() || (notBanned() && isOwner(charDoc(id).data));
      allow update, delete: if isAdmin();
    }

    match /meta/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
